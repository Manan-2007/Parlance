# Optional. Without a key, translation runs in the browser.
GEMINI_API_KEY=
# Optional model override.
# GEMINI_MODEL=gemini-2.5-flash
# Sign → Text "Read signs from video" (experimental): model and thinking budget.
# Without GEMINI_API_KEY it uses the AZURE_OPENAI_* vision deployment below, if set.
# GEMINI_SIGN_MODEL=gemini-2.5-flash
# GEMINI_SIGN_THINKING=512
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT=
# Optional recognition service configuration.
# PARLANCE_API_PORT=8000
# PARLANCE_PYTHON=.venv/bin/python
# VITE_PARLANCE_WS=ws://127.0.0.1:8000/ws
# Azure neural voice output. Set a Speech resource key for this region.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Optional custom Speech resource host, without the API path.
# AZURE_SPEECH_ENDPOINT=https://your-resource.cognitiveservices.azure.com
