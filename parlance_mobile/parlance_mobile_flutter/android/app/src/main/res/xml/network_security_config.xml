<?xml version="1.0" encoding="utf-8"?>
<!-- The 3D signer bundled in the app is served to the web view from this phone
     (http://127.0.0.1:<port>/signer/, see lib/core/offline_server_io.dart), so
     plain HTTP is allowed to the phone itself, and nowhere else. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
